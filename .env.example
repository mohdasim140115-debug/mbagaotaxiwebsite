# ---- Required ----
# MySQL 8 connection (least-privilege app user: SELECT/INSERT/UPDATE/DELETE on the app schema;
# migrations additionally need CREATE/ALTER/INDEX/DROP/REFERENCES — use a separate migrator user in production if preferred)
DATABASE_URL=mysql://mba_app:password@127.0.0.1:3306/mba_travels
# Public canonical origin, no trailing slash
SITE_URL=https://mbatravelsgoa.com
# 32+ random bytes (hex). Used to hash IPs in enquiry/rate-limit records.
APP_SECRET=replace-with-64-hex-chars
# Absolute or project-relative directory for uploaded media (must persist across deploys, outside .next)
STORAGE_DIR=./storage/uploads

# ---- Optional ----
# Set to "true" on staging so every page sends noindex and robots.txt disallows all
STAGING=false
# Enquiry notification email (SMTP). Leave blank to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
